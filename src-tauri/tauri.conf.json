{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TodoCalendar",
  "version": "0.4.34",
  "identifier": "com.todocalendar.app",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TodoCalendar",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/icon_a1_32.png",
      "icons/icon_a1_64.png",
      "icons/icon_a1_128.png",
      "icons/icon_a1_256.png",
      "icons/icon_a1.ico",
      "icons/icon_a2_32.png",
      "icons/icon_a2_64.png",
      "icons/icon_a2_128.png",
      "icons/icon_a2_256.png",
      "icons/icon_a2.ico",
      "icons/icon_b_32.png",
      "icons/icon_b_64.png",
      "icons/icon_b_128.png",
      "icons/icon_b_256.png",
      "icons/icon_b.ico",
      "icons/icon_bf_32.png",
      "icons/icon_bf_64.png",
      "icons/icon_bf_128.png",
      "icons/icon_bf_256.png",
      "icons/icon_bf.ico",
      "resources/holidays.json"
    ],
    "category": "Productivity",
    "shortDescription": "Lightweight calendar + todo app",
    "longDescription": "A lightweight calendar-integrated todo application with nested subtasks.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "./nsis/installer.nsi",
        "languages": ["SimpChinese"],
        "customLanguageFiles": {
          "SimpChinese": "./nsis/languages/SimpChinese.nsh"
        }
      }
    }
  }
}
